# Overrides for apps/service/.env when using docker-compose.deps.yml + yarn dev.
# Merge these into .env (or temporarily replace DB_* / REDIS_URL).

DB_HOST=127.0.0.1
DB_USER=apollo
DB_PASSWORD=apollo
DB_SCHEMA=apollo

REDIS_URL=redis://127.0.0.1:6379
NO_REDIS=0

# packages/db/.env — same host for migrations:
# DB_MIGRATE_HOST=127.0.0.1
# DB_MIGRATE_USER=apollo
# DB_MIGRATE_PASSWORD=apollo
# DB_MIGRATE_SCHEMA=apollo
