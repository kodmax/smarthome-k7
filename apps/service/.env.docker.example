# Copy to apps/service/.env.docker — used by docker compose (gitignored).
# NODE_ENV=production disables dotenv file loading in apps/service/src/config.ts.

NODE_ENV=production

# Runtime pool + migrations (same MariaDB instance in Compose)
DB_HOST=mariadb
DB_USER=apollo
DB_PASSWORD=apollo
DB_SCHEMA=apollo

DB_MIGRATE_HOST=mariadb
DB_MIGRATE_USER=apollo
DB_MIGRATE_PASSWORD=apollo
DB_MIGRATE_SCHEMA=apollo

NO_KNX=1
NO_CRON=1
NO_REDIS=0

REDIS_URL=redis://redis:6379
CACHE_DIR=.cache

# Dummy values — enough for service startup on Mac; scrapers may log errors until real credentials are set.
LOCATION_LONG=21.0122
LOCATION_LAT=52.2297
GOOGLE_SOCS_COOKIE=dummy
NFJ_COOKIE=dummy
THEPROTOCOL_COOKIE=dummy
TRANSMISSION_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_USERNAME=dummy
TRANSMISSION_PASSWORD=dummy
OPENAI_API_KEY=dummy

# SENTRY_DSN=
# SENTRY_RELEASE=
# LOG_LEVEL=info
