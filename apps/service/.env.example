# Runtime mode — @repo/env reads NODE_ENV when the process starts (set in /etc/apollo/apollo.env on Pi).
# NODE_ENV=production

# Runtime PostgreSQL pool (@repo/db) — SELECT/INSERT/UPDATE user
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_SCHEMA=

# Optional MCP overrides (e.g. SSH tunnel: DB_MCP_HOST=127.0.0.1 while DB_HOST stays LAN IP)
# DB_MCP_HOST=
# DB_MCP_PORT=5432
# DB_MCP_USER=
# DB_MCP_PASSWORD=

NO_KNX=0
NO_CRON=0
NO_REDIS=0
KNX_HOST=

REDIS_URL=redis://localhost:6379

CACHE_DIR=.cache

LOCATION_LONG=
LOCATION_LAT=

GOOGLE_SOCS_COOKIE=
NFJ_COOKIE=
THEPROTOCOL_COOKIE=

# Transmission RPC (@repo/transmission)
TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

# OpenTelemetry tracing — Alloy receives OTLP, forwards to Tempo (set in /etc/apollo/apollo.env on Pi)
# OTEL_SDK_DISABLED=1
# OTEL_TRACES_EXPORTER=none
# OTEL_SERVICE_NAME=apollo-daemon
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2
#
# Local smoke test (spans in stdout, no Alloy/Tempo required):
# OTEL_TRACES_EXPORTER=console

# Prometheus metrics (process, scrapers, WebSocket, MariaDB, js-knx OTEL) — scraped from GET /metrics
# NO_METRICS=1
# METRICS_PORT=9464

# API_PORT=3679

# Sentry (backend, runtime — set on the production server via systemd)
SENTRY_DSN=
# Git SHA — updated by scripts/update.sh on each deploy (must match uploaded source maps).
SENTRY_RELEASE=

# Log level (default: info). Set LOG_LEVEL=debug for verbose output.
# trace | debug | info | warn | error | fatal
LOG_LEVEL=

# Prepends systemd journald priority prefix (<0-7>) to JSON log lines.
# Enable on Pi in /etc/apollo/apollo.env when running under systemd + Alloy.
# LOG_JOURNALD=1

# Per-component overrides (LOG_LEVEL_<NAME> → pass to logger.child(..., { level: readScopedLogLevel('<name>') })):
# LOG_LEVEL_WS=error
# LOG_LEVEL_FEEDS=error
# LOG_LEVEL_KNX_CRON=error
# LOG_LEVEL_FEEDS_CRON=error
