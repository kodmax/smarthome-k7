# Runtime mode — production bundle is built with NODE_ENV=production (scripts/update.sh on Pi).
# NODE_ENV=production

# Runtime MariaDB pool (@repo/db) — SELECT/INSERT/UPDATE user
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=

# Optional MCP overrides (e.g. SSH tunnel: DB_MCP_HOST=127.0.0.1 while DB_HOST stays LAN IP)
# DB_MCP_HOST=
# DB_MCP_PORT=3306
# DB_MCP_USER=
# DB_MCP_PASSWORD=

NO_KNX=0
NO_CRON=0
NO_REDIS=0
KNX_HOST=

REDIS_URL=redis://localhost:6379

CACHE_DIR=.cache

LOCATION_LONG=
LOCATION_LAT=

GOOGLE_SOCS_COOKIE=
NFJ_COOKIE=
THEPROTOCOL_COOKIE=

# Transmission RPC (@repo/transmission)
TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

# Sentry (backend, runtime — set on the production server via systemd)
SENTRY_DSN=
# Git SHA — updated by scripts/update.sh on each deploy (must match uploaded source maps).
SENTRY_RELEASE=

# Log level (default: info). Set LOG_LEVEL=debug for verbose output.
# trace | debug | info | warn | error | fatal
LOG_LEVEL=

# Per-component overrides (child logger `component` binding → LOG_LEVEL_<NAME>):
# LOG_LEVEL_WS=debug
# LOG_LEVEL_FEEDS=debug
# LOG_LEVEL_KNX=debug
# LOG_LEVEL_KNX_CRON=debug
# LOG_LEVEL_FEEDS_CRON=debug
