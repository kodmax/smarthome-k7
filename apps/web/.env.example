# Optional backend origin (defaults to current page origin).
# Dev proxy serves WebSocket at /ws and HTTP API at /api on the same origin.
# VITE_BACKEND_BASE_URL=https://smarthome.example.com

# Sentry (frontend). Required at build time (vite build), not runtime.
# Export before yarn build; see also deploy.secrets.env on the build machine.
VITE_SENTRY_DSN=
# Git SHA — same value as SENTRY_RELEASE in the deploy script.
VITE_SENTRY_RELEASE=
