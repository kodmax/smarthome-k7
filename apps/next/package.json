    "@repo/assets": "*",
    "@repo/design-tokens": "*",
    "@repo/i18n": "*",
    "@repo/styles": "*",
    "lucide-react": "^1.23.0",
    "next": "^15.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "5.5.4"
