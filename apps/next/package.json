{
  "name": "next-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "format": "prettier --write \"**/*.{ts,tsx,md}\" --ignore-path .gitignore",
    "lint": "eslint \"app/**/*.ts?\" \"app/**/*.tsx\" \"i18n/**/*.ts?\" \"i18n/**/*.tsx\"",
    "verify": "yarn format && yarn lint && yarn build"
  },
  "dependencies": {
