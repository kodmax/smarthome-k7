{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_WEB_PROJECT",
    "SENTRY_SERVICE_PROJECT",
    "SENTRY_RELEASE",
    "VITE_SENTRY_DSN",
    "VITE_SENTRY_RELEASE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "format": {},
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
