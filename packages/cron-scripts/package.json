{
  "name": "@repo/cron-scripts",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "transpile": "node ../../scripts/transpile-package.mjs",
    "dev": "node ../../scripts/transpile-package.mjs --watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "main": "./dist/knx/schedule.js",
  "types": "./src/knx/schedule.ts",
  "exports": {
    ".": {
      "types": "./src/knx/schedule.ts",
      "default": "./dist/knx/schedule.js"
    },
    "./knx/schedule": {
      "types": "./src/knx/schedule.ts",
      "default": "./dist/knx/schedule.js"
    }
  },
  "dependencies": {
    "@repo/chronos": "*",
    "@repo/db": "*",
    "@repo/knx-schema": "*",
    "@repo/logger": "*",
    "dotenv": "^17.4.2",
    "js-knx": "^3.4.0",
    "sony-bravia-ip-control": "^1.1.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^17.0.45",
    "typescript": "5.5.4"
  }
}
