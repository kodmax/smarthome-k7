{
  "name": "@repo/env",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": {
        "types": "./src/client.ts",
        "import": "./src/client.ts",
        "default": "./src/client.ts"
      },
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^17.0.35",
    "eslint": "^8.57.0",
    "typescript": "5.5.4",
    "vite": "^8.1.0"
  }
}
