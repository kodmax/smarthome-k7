{
  "name": "@repo/logger",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "transpile": "node ../../scripts/transpile-package.mjs",
    "dev": "node ../../scripts/transpile-package.mjs --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/env": "*",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^17.0.35",
    "eslint": "^8.57.0",
    "pino-pretty": "^13.1.3",
    "typescript": "5.5.4",
    "vitest": "^4.1.8"
  }
}
