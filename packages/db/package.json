{
  "name": "@repo/db",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "transpile": "node ../../scripts/transpile-package.mjs",
    "dev": "node ../../scripts/transpile-package.mjs --watch",
    "db:migrate": "node -r dotenv/config scripts/migrate.js up",
    "db:migrate-cv-match-data": "node -r dotenv/config scripts/migrate-cv-match-documents.js",
    "db:rollback-cv-match-data": "node -r dotenv/config scripts/rollback-cv-match-documents.js",
    "db:rollback": "node -r dotenv/config scripts/migrate.js down",
    "db:status": "node -r dotenv/config scripts/migrate.js status",
    "db:create": "node scripts/migrate.js create"
  },
  "dependencies": {
    "@repo/logger": "*",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "dotenv": "^17.4.2",
    "typescript": "5.5.4"
  }
}
